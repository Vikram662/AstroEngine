# Copy to .env and fill in. Never commit real values.
# Full description of every variable: README.md > "Environment variables".

# ── Required ──────────────────────────────────────────────────────────────────
# Must equal the frontend's ASTRO_INTERNAL_SECRET.
INTERNAL_SECRET_KEY=
# Base URL of the Next.js app (API-key verification, settings, refunds).
NEXT_APP_URL=http://localhost:3000
# "production" in production. "development" enables a local test-key bypass: never in production.
ENVIRONMENT=production
# Swiss Ephemeris data directory (.se1 files).
EPHE_PATH=./ephe

# ── Optional ──────────────────────────────────────────────────────────────────
# PORT=8000
# CORS_ORIGINS=https://app.example.com
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# SENTRY_DSN=
# PDF_MAX_CONCURRENCY=2
# BILLING_LOG_LATENCY=true
# Fallback R2 settings (normally provided through the frontend Admin > Settings):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_DOMAIN=
