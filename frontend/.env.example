# Copy to .env.local (development) or .env (production) and fill in. Never commit real values.
# Full description of every variable: README.md > "Environment variables".

# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/astroengine"
# 32+ random bytes, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mandatory in production (optional only for `next dev`). Must differ from ASTRO_INTERNAL_SECRET.
SESSION_SECRET=
# Shared with the Python backend (backend INTERNAL_SECRET_KEY must be the same value).
ASTRO_INTERNAL_SECRET=
ASTRO_BACKEND_URL=http://127.0.0.1:8000
# Raw API key of an ADMIN account (printed once by `npm run seed`).
ASTRO_INTERNAL_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Recommended in production ─────────────────────────────────────────────────
# REDIS_URL=redis://:password@127.0.0.1:6379
# Encrypts Razorpay / R2 / SMTP secrets stored in the database. BACK THIS UP.
# SETTINGS_ENCRYPTION_KEY=
# Number of reverse proxies in front of Next.js (used to read the real client IP).
# TRUSTED_PROXY_HOPS=1

# ── Payments / email / storage ─────────────────────────────────────────────────
# Admin > Settings values take priority over these.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_NAME=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_DOMAIN=

# ── Optional tuning ───────────────────────────────────────────────────────────
# PROXY_ANON_RPM=120
# PROXY_USER_RPM=600
# PROXY_HEAVY_RPM=10
# PLAYGROUND_RPM=20

# ── Seed scripts only (never in production) ───────────────────────────────────
# SEED_ADMIN_PASSWORD=
# SEED_DEV_PASSWORD=
# ASTRO_MASTER_API_KEY=
